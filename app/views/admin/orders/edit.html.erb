<%= render 'layouts/nav1' %>

<div class="max-w-2xl mx-auto mt-10 bg-white shadow-md rounded-lg p-8">
  <h1 class="text-2xl font-bold text-gray-800 mb-2">Update Order Status</h1>
  <h4 class="text-lg text-gray-600 mb-6">Order #<%= @order.id %></h4>

  <%= form_with(model: [:admin, @order], local: true, class: "space-y-6") do |form| %>
    <div>
      <%= form.label :status, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.select :status,
          options_for_select(
            Order::STATUSES.map { |status| [status.titleize, status] },
            @order.status
          ),
          {},
          class: "block w-full border border-gray-300 rounded-md shadow-sm p-2 focus:ring-blue-500 focus:border-blue-500"
        %>
    </div>

    <div class="flex space-x-4">
      <%= form.submit 'Update Status', class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition" %>
      <%= link_to 'Cancel', admin_orders_path, class: "bg-gray-200 text-gray-800 px-4 py-2 rounded-md hover:bg-gray-300 transition" %>
    </div>
  <% end %>
</div>
