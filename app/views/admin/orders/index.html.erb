
<%= render 'layouts/nav1' %>
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="text-3xl font-bold mb-6 text-gray-800">Order Management</h1>

  <div class="overflow-x-auto rounded-lg shadow">
    <table class="min-w-full bg-white border border-gray-200">
      <thead class="bg-gray-100 text-gray-700 text-sm uppercase text-left">
        <tr>
          <th class="px-6 py-3 border-b">Order ID</th>
          <th class="px-6 py-3 border-b">Status</th>
          <th class="px-6 py-3 border-b">Total</th>
          <th class="px-6 py-3 border-b">Date</th>
          <th class="px-6 py-3 border-b">Actions</th>
        </tr>
      </thead>
      <tbody class="text-sm text-gray-800">
        <% @orders.each do |order| %>
          <tr class="hover:bg-gray-50 transition">
            <td class="px-6 py-4 border-b"><%= order.id %></td>
            <td class="px-6 py-4 border-b">
              <span class="inline-block px-2 py-1 text-xs font-semibold rounded-full 
                <%= {
                  'pending' => 'bg-yellow-100 text-yellow-800',
                  'shipped' => 'bg-blue-100 text-blue-800',
                  'delivered' => 'bg-green-100 text-green-800',
                  'cancelled' => 'bg-red-100 text-red-800'
                }[order.status] || 'bg-gray-100 text-gray-800' %>">
                <%= order.status.titleize %>
              </span>
            </td>
            <td class="px-6 py-4 border-b"><%= number_to_currency(order.total_price) %></td>
            <td class="px-6 py-4 border-b"><%= order.created_at.to_formatted_s(:short) %></td>
            <td class="px-6 py-4 border-b">
              <%= link_to 'View/Edit', edit_admin_order_path(order), class: 'inline-block bg-blue-500 hover:bg-blue-600 text-white text-xs font-medium py-2 px-3 rounded' %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
